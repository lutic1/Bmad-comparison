+@router.post("/{order_id}/refund", response_model=RefundOut)
+def refund_order(
+    order_id: int,
+    db: Session = Depends(get_db),
+    user: User = Depends(get_current_user),
+) -> RefundOut:
+    order = db.get(Order, order_id)
+    if order is None or order.user_id != user.id:
+        raise HTTPException(status_code=404, detail="Order not found")
+    if order.refunded:
+        raise HTTPException(status_code=409, detail="Order already refunded")
+    if datetime.utcnow() - order.created_at > timedelta(days=30):
+        raise HTTPException(status_code=400, detail="Refund window expired")
+    order.refunded = True
+    order.refunded_at = datetime.utcnow()
+    db.commit()
+    db.refresh(order)
+    return RefundOut(
+        order_id=order.id,
+        user_id=order.user_id,
+        refunded_at=order.refunded_at,
+    )
+
+
