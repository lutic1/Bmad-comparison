+        f"/orders/{order['id']}/refund",
+        headers={"X-User-Id": str(other["id"])},
+    )
+
+    assert resp.status_code == 404
+
+    from sqlalchemy.orm import Session
+
+    with Session(bind=db_engine) as session:
