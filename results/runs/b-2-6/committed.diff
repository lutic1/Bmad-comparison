+openapi: 3.0.3
+info:
+  title: Order Refund
+  version: 1.0.0
+  description: |
+    Contract for the POST /orders/{order_id}/refund endpoint added by the
+    001-order-refund feature. Auth model mirrors the rest of the service:
+    the caller identifies themselves via the X-User-Id header.
+
+paths:
+  /orders/{order_id}/refund:
+    post:
+      summary: Refund an order
+      operationId: refundOrder
+      tags: [orders]
+      parameters:
+        - in: path
+          name: order_id
+          required: true
+          schema:
+            type: integer
+            minimum: 1
+        - in: header
+          name: X-User-Id
+          required: true
+          schema:
+            type: integer
+            minimum: 1
+          description: |
+            Identifies the calling user. Same mechanism used by every
+            other authenticated endpoint in this service.
+      responses:
+        '201':
+          description: Refund created. Order is now marked as refunded.
+          content:
+            application/json:
+              schema:
+                $ref: '#/components/schemas/RefundOut'
+        '400':
+          description: |
+            The order was created more than 30 days ago and is outside
+            the refund window.
+          content:
+            application/json:
+              schema:
+                $ref: '#/components/schemas/Error'
+        '401':
+          description: Missing or unknown X-User-Id header.
+          content:
+            application/json:
+              schema:
+                $ref: '#/components/schemas/Error'
+        '404':
+          description: |
+            Either the order does not exist, or it exists but belongs to
+            a different user. The two cases are deliberately
+            indistinguishable to avoid disclosing the existence of
+            other users' orders.
+          content:
+            application/json:
+              schema:
+                $ref: '#/components/schemas/Error'
+        '409':
+          description: The order has already been refunded.
+          content:
+            application/json:
+              schema:
+                $ref: '#/components/schemas/Error'
+
+components:
+  schemas:
+    RefundOut:
+      type: object
+      required: [id, order_id, amount, created_at]
+      properties:
+        id:
+          type: integer
+          description: Refund identifier.
+        order_id:
+          type: integer
+          description: The order this refund applies to.
+        amount:
+          type: integer
+          description: |
+            Refunded amount in integer cents. Snapshot of the order's
+            total at the time of refund.
+        created_at:
+          type: string
+          format: date-time
+          description: ISO 8601 timestamp of when the refund was issued.
+    Error:
+      type: object
+      required: [detail]
+      properties:
+        detail:
+          type: string
+          description: FastAPI default error shape.
