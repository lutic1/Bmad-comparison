+@router.post("/{order_id}/refund", response_model=RefundOut)
+def refund_order(
+    order_id: int,
+    db: Session = Depends(get_db),
+    user: User = Depends(get_current_user),
+) -> RefundOut:
+    order = db.get(Order, order_id)
+    if order is None:
+        raise HTTPException(status_code=404, detail="order not found")
+    if order.user_id != user.id:
+        raise HTTPException(status_code=403, detail="forbidden")
+    if order.refunded:
+        raise HTTPException(status_code=422, detail="order already refunded")
+    if (datetime.utcnow() - order.created_at).days > 30:
+        raise HTTPException(status_code=422, detail="refund window expired")
+
+    order.refunded = True
+    order.refunded_at = datetime.utcnow()
+    db.commit()
+    db.refresh(order)
+
+    return RefundOut(order_id=order.id, refunded_at=order.refunded_at, amount=order.total)
+
+
 def adjust_total(order: Order, delta_cents: int) -> None:
     order.total = max(0, order.total + delta_cents)
 
