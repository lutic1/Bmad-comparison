+        raise HTTPException(status_code=409, detail="order already refunded")
+    if datetime.utcnow() - order.created_at > REFUND_WINDOW:
+        raise HTTPException(status_code=422, detail="refund window expired")
+
+    refund = Refund(order_id=order.id, amount=order.total)
+    db.add(refund)
+    db.flush()
+    order.refunded_at = refund.created_at
+    db.commit()
+    db.refresh(refund)
+
+    return RefundOut(
+        id=refund.id,
+        order_id=refund.order_id,
+        amount=refund.amount,
+        created_at=refund.created_at,
+    )
+
+
 def adjust_total(order: Order, delta_cents: int) -> None:
     order.total = max(0, order.total + delta_cents)
 
